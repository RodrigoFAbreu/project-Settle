{
  "schema_version": 1,
  "trunk": {"branch": "main", "remote": "origin"},
  "forge": {"kind": "github", "repository": "RodrigoFAbreu/project-Settle"},
  "milestone_branches": {
    "enabled": true,
    "branch_format": "feature/{work_item_id}",
    "pull_request": {"draft": true, "ready_requires_green_checks": true, "merge_method": "squash",
                     "auto_merge": true, "release_workflow": "ci.yml"}
  },
  "release": {
    "enabled": true,
    "trigger": "conventional_commit",
    "change_types": {"feat": "minor", "fix": "patch", "perf": "patch", "refactor": "patch",
                     "revert": "patch", "build": "patch", "style": "patch", "docs": "patch",
                     "test": "patch", "chore": "patch", "ci": "none"},
    "version_scheme": "semver",
    "tag_format": "v{version}",
    "build": {"kind": "command", "argv": ["bash", "scripts/release/build.sh", "{version}"]},
    "verify": {"kind": "command", "argv": ["bash", "scripts/release/verify.sh", "{artifact}"]},
    "artifacts": {"paths": ["dist/settle-v{version}.zip"], "checksums": "SHA256SUMS"},
    "publication": {"kind": "github_release", "title": "{tag}",
                    "notes": "Settle {tag}: the built site as a zip and SHA256SUMS. The homelab image is published from it."}
  }
}
